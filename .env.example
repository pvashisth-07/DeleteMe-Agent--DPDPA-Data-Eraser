# ==============================================================================
# DeleteMe DPDPA Rights Agent - Environment Configuration
# ==============================================================================

# ASI:One API Configuration (OpenAI Compatible)
ASI1_API_KEY=mock-asi1-key-change-me
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1

# Agentverse Seeds (Distinct secret phrases for each autonomous agent)
CONCIERGE_SEED=deleteme_concierge_seed_phrase_demo_2026_oct
DISCOVERY_SEED=deleteme_discovery_seed_phrase_demo_2026_oct
DRAFTER_SEED=deleteme_drafter_seed_phrase_demo_2026_oct
DISPATCHER_SEED=deleteme_dispatcher_seed_phrase_demo_2026_oct
TRACKER_SEED=deleteme_tracker_seed_phrase_demo_2026_oct
MOCK_COMPANY_SEED=deleteme_mock_company_seed_phrase_demo_2026_oct

# Agentverse Addresses (Auto-derived from seeds)
CONCIERGE_ADDR=agent1qfq66d3thuzjl620d06sqn88j0ey650up6ltwt46qhljraz2fe4g50yap2z
DISCOVERY_ADDR=agent1qtsk8vqfdywqg89mswxg29dpeftnnxq6jvmp0yphv9z5vcl67fgrjdsdnqg
DRAFTER_ADDR=agent1q0su27nruzqk75kpwdtese6k083lde3lzj2aw5yawfw00y9d9u6kcffus6l
DISPATCHER_ADDR=agent1qwmqhv5ll2fswhhvfxtzywfsxew2a3ufln2tsj8vzkzdktd789tpw7cmmup
TRACKER_ADDR=agent1qfs4f9apm6hg066577z8t2my673s9d0gcx2jjafeatujvpcpgr2ag9swpsd
MOCK_COMPANY_ADDR=agent1qwhk3gqawq5auzsddt44mt77wrr8078yvzexp9l35cq22vymfus3qex5je4

# Agentverse Mailbox & API Credentials
AGENTVERSE_API_KEY=
AGENT_MAILBOX_KEY=

# Runtime & Demo Clock Controls
DEBUG_MODE=true
DEMO_CLOCK_SPEED=1                # 1 = real time; 86400 = 1 sec is 1 day in demo mode
SESSION_TTL_MINUTES=30
APPROVAL_HMAC_SECRET=replace_with_a_secure_hmac_secret_string_minimum_32_chars
PAYMENTS_BYPASS_FOR_DEMO=true

# Dispatch & SMTP Send Settings
# SEND_MODE options: 'dry_run' | 'demo_redirect' | 'live'
SEND_MODE=dry_run
DEMO_RECIPIENT_OVERRIDE=demo-inbox@example.com
CONFIRM_LIVE=false
REPLY_BASE=requests@deleteme.local
FROM_EMAIL=deleteme-agent@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# IMAP Inbound Poller Settings
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# SQLite Local Database
DB_PATH=data/deleteme.db
